# Lockfile age-check allowlist. One entry per line. Comments start with `#`.
#
# Format:
#   <ecosystem>:<name>           — exempt every version of the package
#   <ecosystem>:<name>@<version> — exempt one specific version
#
# Ecosystems: cargo, npm
#
# Always include WHY in a comment above the entry, and remove the entry once
# the underlying version has aged past the threshold. Entries here weaken our
# supply-chain posture; they should be temporary.
#
# Example:
#   # CVE-2026-XXXX patched in 0.2.4, no older fix available
#   cargo:somecrate@0.2.4

# why: soundness advisory in anyhow <=1.0.102 (dtolnay/anyhow#451) turns the
# cargo-deny advisories gate red; 1.0.103 is the designated fix and is 6 days
# old at time of bump — the same security exception Dependabot PRs get
# automatically. Safe to remove after 2026-07-03.
cargo:anyhow@1.0.103

# why: RUSTSEC-2026-0194 + RUSTSEC-2026-0195 (quadratic attribute duplicate
# checks / unbounded namespace allocations in quick-xml <0.41 — DoS class)
# turn the cargo-deny advisories gate red; quick-xml 0.41.0 (2026-06-29) is
# the designated fix and plist 1.10.0 (2026-07-04) is the first release
# requiring it. Same security exception Dependabot PRs get automatically.
# Safe to remove after 2026-07-11.
cargo:quick-xml@0.41.0
cargo:plist@1.10.0

# why: RUSTSEC-2026-0204 (invalid pointer dereference in crossbeam-epoch's
# fmt::Pointer/Display impl for Atomic/Shared — NULL-pointer-deref DoS class)
# turns the cargo-deny advisories gate red; crossbeam-epoch 0.9.20 (2026-07-06)
# is the designated fix (patched >=0.9.20) and is 4 days old at time of bump —
# the same security exception Dependabot PRs get automatically.
# Safe to remove after 2026-07-13.
cargo:crossbeam-epoch@0.9.20

# why: RUSTSEC-2026-0258 (h2 accepts and queues empty DATA frames without
# limit — unbounded memory / panic, DoS class) turns the cargo-deny advisories
# gate red; h2 reaches us transitively through gix -> gix-transport -> reqwest
# -> hyper. 0.4.16 (2026-08-17) is the designated fix and 0.4.18 (2026-08-20)
# is what `cargo update -p h2` resolves to — both inside the 7-day window.
# Same security exception Dependabot PRs get automatically.
# Safe to remove after 2026-08-28.
cargo:h2@0.4.18

# why: RUSTSEC-2026-0285 / GHSA-2mjx-qc3c-rqvc (rustls accepts TLS 1.3
# handshake messages that span a key change, which RFC 8446 §5.1 forbids)
# turns the cargo-deny advisories gate red on every lockfile PR; rustls reaches
# us transitively through gix -> gix-transport -> reqwest. 0.23.45 (2026-09-14)
# is the designated fix and is 4 days old at time of bump — the same security
# exception Dependabot PRs get automatically (GitHub has no advisory for it
# yet, so no Dependabot security PR is coming). The rustls-webpki / aws-lc-rs /
# aws-lc-sys bumps it requires are all past the gate already.
# Safe to remove after 2026-09-21.
cargo:rustls@0.23.45

# why: RUSTSEC-2026-0382 (rustls-webpki accepts certificate paths through
# distrusted emSign intermediates whose private keys are now public) turns the
# cargo-deny advisories gate red on every lockfile PR; rustls-webpki reaches us
# transitively through gix -> gix-transport -> reqwest -> rustls. 0.103.16
# (2026-10-20) is the designated fix and is 4 days old at time of bump — the
# same security exception Dependabot PRs get automatically.
# Safe to remove after 2026-10-27.
cargo:rustls-webpki@0.103.16

# why: RUSTSEC-2026-0383 (webpki-root-certs bundles emSign ECC Root CA - G3,
# which chains to the same distrusted intermediates). It is only reachable on
# targets outside deny.toml's [graph] targets, so the gate never flags it, but
# it is in Cargo.lock and gets bumped with its sibling. 1.0.10 (2026-10-19) is
# the designated fix and is 5 days old at time of bump.
# Safe to remove after 2026-10-26.
cargo:webpki-root-certs@1.0.10

# why: clipboard-win 5.4.1 (Windows-only, via edtui -> arboard) was yanked,
# which `yanked = "deny"` in deny.toml turns red on every lockfile PR. 5.4.2
# (2026-10-23) is the replacement — it fixes an out-of-bounds read in
# raw::get_html (DoumanAsh/clipboard-win#42) — and is 1 day old at time of
# bump. Safe to remove after 2026-10-30.
cargo:clipboard-win@5.4.2

# why: first-party packages — released from avihut/dumbshow by its own pipeline
# with provenance and pinned exact here; the age gate guards against hijacked
# third-party releases, which does not apply to our own (mirrors the
# minimumReleaseAgeExcludes entries in bunfig.toml / docs/bunfig.toml). One
# line per pinned version: every bump re-adds the new versions the day they cut.
npm:@dumbshow/core@0.4.1
npm:@dumbshow/vue@0.4.1
